# Exemple de configuration locale.
# Copiez ce fichier en .env.local (non versionné) puis adaptez les valeurs :
#
#     cp .env.local.dist .env.local
#
# Pour les tests, copiez-le aussi en .env.test.local : Symfony ne lit pas .env.local en environnement « test ».
# Avec « symfony serve », les variables de la base Docker (DATABASE_URL) sont injectées automatiquement.
# Ne mettez jamais de vrais secrets de production dans un fichier versionné.

APP_ENV=dev
# Générez une valeur : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
APP_SHARE_DIR=var/share

# Adresse utilisée pour générer des URL hors requête HTTP (commandes, e-mails).
DEFAULT_URI=http://localhost

# PostgreSQL 16 : remplacez l'utilisateur, le mot de passe et le nom de la base.
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# null://null n'envoie rien. Avec Mailpit : smtp://127.0.0.1:1025
MAILER_DSN=null://null

LOCK_DSN=flock
