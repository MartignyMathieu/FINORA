<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#f4f7fc">
        {# Application installable : manifeste et icônes (public/), et réglages des appareils Apple (écran d'accueil). #}
        <link rel="manifest" href="/manifest.webmanifest">
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-title" content="FINORA">
        <meta name="apple-mobile-web-app-status-bar-style" content="black">
        {# Transition fondue entre les pages (Turbo, navigateurs qui la gèrent) ; coupée par le CSS si les animations sont réduites. #}
        <meta name="view-transition" content="same-origin">
        {# Avant le premier affichage : applique le thème choisi (pas d'éclair de thème clair ; sans choix, c'est l'appareil qui décide, via le CSS)
           et décide des animations (data-fx) : « Complètes » force, « Réduites » coupe, sinon on suit la préférence du système. Même règle que assets/motion.js. #}
        <script>(function(){var d=document.documentElement,t=null,f=null;try{t=localStorage.getItem('finora-theme');f=localStorage.getItem('finora-motion');}catch(e){}try{if(t==='dark'||t==='light'){d.dataset.theme=t;}var dark=t==='dark'||t!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches;var m=document.querySelector('meta[name="theme-color"]');if(m){m.content=dark?'#081326':'#f4f7fc';}try{if(localStorage.getItem('finora-hide-balance')==='1'){d.dataset.hideBalance='1';}}catch(e){}d.dataset.fx=(f==='full'||(f!=='reduce'&&!matchMedia('(prefers-reduced-motion: reduce)').matches))?'on':'off';}catch(e){}})();</script>
        <title>{% block title %}Accueil{% endblock %} · FINORA</title>
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 640 620'%3E%3Cpath fill='%231f6fef' d='M190 308C198 150 300 62 470 60L606 58C596 135 560 196 478 199L330 201C262 206 218 256 190 308Z'/%3E%3Cpath fill='%2319aaff' d='M148 514C176 400 206 252 342 246L518 243C536 244 522 300 490 336C466 360 440 366 396 366L342 368C316 372 308 400 300 432C284 486 232 520 148 514Z'/%3E%3C/svg%3E">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@700;800&display=swap">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# Bandeau « hors ligne » / « copie du … » (offline_status_controller) : caché tant que tout va bien. #}
        <div class="offline-bar" data-controller="offline-status" role="status" aria-live="polite" hidden>
            <span data-offline-status-target="message"></span>
            <button type="button" data-offline-status-target="reload" data-action="offline-status#reload" hidden>Actualiser</button>
        </div>
        {% block layout %}
        {% set route = app.current_route|default('') %}
        {% set nav = [
            {key: 'home', label: 'Accueil', icon: 'home', path: path('app_home'), active: route == 'app_home'},
            {key: 'accounts', label: 'Comptes', icon: 'wallet', path: path('app_account_index'), active: route starts with 'app_account'},
            {key: 'transactions', label: 'Transactions', icon: 'card', path: path('app_transaction_index'), active: route starts with 'app_transaction'},
            {key: 'recurring', label: 'Récurrences', icon: 'repeat', path: path('app_recurring_index'), active: route starts with 'app_recurring'},
            {key: 'budgets', label: 'Budgets', icon: 'basket', path: path('app_budget_index'), active: route starts with 'app_budget'},
            {key: 'goals', label: 'Objectifs', icon: 'target', path: path('app_goal_index'), active: route starts with 'app_goal'},
            {key: 'stats', label: 'Statistiques', icon: 'chart', path: path('app_stats'), active: route == 'app_stats'},
        ] %}
        {% set settings_active = route == 'app_settings' or route starts with 'app_category' %}

        <aside class="sidebar">
            <a class="logo" href="{{ path('app_home') }}" aria-label="FINORA — accueil">
                {{ include('_logo_mark.html.twig', {size: 40}) }}
                <span class="logo-word">FINORA</span>
            </a>
            <nav class="nav" aria-label="Navigation principale">
                {% for item in nav %}
                    <a href="{{ item.path }}" class="{{ item.active ? 'active' }}"{% if item.active %} aria-current="page"{% endif %}>{{ icon(item.icon, 20) }}{{ item.label }}{% if item.key == 'budgets' and budget_alerts() is not empty %}{{ include('_alert_badge.html.twig') }}{% endif %}{% if item.key == 'accounts' and pending_invitation_count() > 0 %}<span class="alert-badge" role="img" aria-label="{{ pending_invitation_count() }} invitation{{ pending_invitation_count() > 1 ? 's' }} de partage">{{ pending_invitation_count() }}</span>{% endif %}</a>
                {% endfor %}
                <a href="{{ path('app_calendar') }}" class="{{ route == 'app_calendar' ? 'active' }}"{% if route == 'app_calendar' %} aria-current="page"{% endif %}>{{ icon('calendar', 20) }}Calendrier</a>
                <div class="nav-bottom">
                    <a href="{{ path('app_settings') }}" class="{{ settings_active ? 'active' }}">{{ icon('gear', 20) }}Paramètres</a>
                    {% if app.user %}
                        <div class="sidebar-user">
                            <a href="{{ path('app_profile') }}" class="avatar-link" aria-label="Mon profil" title="Mon profil">{{ include('_avatar.html.twig', {user: app.user, class: 'avatar-sm', size: 18}) }}</a>
                            <a href="{{ path('app_profile') }}" class="sidebar-user-name" title="Mon profil">{{ app.user.displayName }}</a>
                            <div class="sidebar-actions">
                                <button type="button" class="theme-toggle" data-controller="theme" data-action="theme#toggle" title="Changer de thème" aria-label="Basculer entre le thème clair et le thème sombre">
                                    <span class="theme-to-dark">{{ icon('moon', 18) }}</span><span class="theme-to-light">{{ icon('sun', 18) }}</span><span>Thème</span>
                                </button>
                                <a href="{{ path('app_logout') }}" class="logout" title="Se déconnecter" aria-label="Se déconnecter">{{ icon('logout', 18) }}Déconnexion</a>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </nav>
        </aside>

        <div class="main">
            <main class="content" data-controller="reveal">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {% if message is iterable %}
                            {# Message avec bouton « Annuler » (suppression annulable, voir UndoDeletion). #}
                            <div class="flash flash-{{ label }} flash-undo" role="alert" data-controller="flash" data-flash-delay-value="15000">
                                <span>{{ message.message }}</span>
                                <form method="post" action="{{ path('app_undo', {token: message.undo}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('undo' ~ message.undo) }}">
                                    <button class="flash-action" type="submit">Annuler</button>
                                </form>
                                <button type="button" class="flash-close" data-action="flash#close" aria-label="Fermer le message">&times;</button>
                            </div>
                        {% else %}
                            <div class="flash flash-{{ label }}" role="alert" data-controller="flash">{{ message }}<button type="button" class="flash-close" data-action="flash#close" aria-label="Fermer le message">&times;</button></div>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>

        <nav class="tabbar" aria-label="Navigation principale">
            <a href="{{ path('app_home') }}" class="{{ route == 'app_home' ? 'active' }}">{{ icon('home', 22) }}Accueil</a>
            <a href="{{ path('app_account_index') }}" class="{{ route starts with 'app_account' ? 'active' }}">{{ icon('wallet', 22) }}Comptes{% if pending_invitation_count() > 0 %}<span class="alert-badge" role="img" aria-label="{{ pending_invitation_count() }} invitation{{ pending_invitation_count() > 1 ? 's' }} de partage">{{ pending_invitation_count() }}</span>{% endif %}</a>
            <a href="{{ path('app_budget_index') }}" class="{{ route starts with 'app_budget' ? 'active' }}">{{ icon('basket', 22) }}Budgets{% if budget_alerts() is not empty %}{{ include('_alert_badge.html.twig') }}{% endif %}</a>
            <a href="{{ path('app_stats') }}" class="{{ route == 'app_stats' ? 'active' }}">{{ icon('chart', 22) }}Stats</a>
            <a href="{{ path('app_settings') }}" class="{{ settings_active ? 'active' }}">{{ icon('gear', 22) }}Plus</a>
        </nav>

        {# Ajout rapide : pas sur les pages de formulaire, de profil ni de paramètres, où il gênerait. #}
        {% if app.user and not (route ends with '_new' or route ends with '_edit' or route == 'app_profile' or route == 'app_settings') %}
            {{ include('_fab.html.twig') }}
        {% endif %}
        {% endblock %}
    </body>
</html>
