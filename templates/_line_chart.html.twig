{# Courbes revenus / dépenses. Paramètre : chart (voir FinanceStats::lineChart). #}
<div class="chart">
    <svg viewBox="0 0 560 250" role="img" aria-label="Évolution des revenus et des dépenses sur 6 mois">
        <defs>
            <linearGradient id="area-income" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#1f6fef" stop-opacity="0.22"/>
                <stop offset="1" stop-color="#1f6fef" stop-opacity="0.02"/>
            </linearGradient>
        </defs>
        {% for tick in chart.ticks %}
            <line x1="{{ chart.left }}" x2="{{ chart.right }}" y1="{{ tick.y }}" y2="{{ tick.y }}" class="grid"/>
            <text x="{{ chart.left - 8 }}" y="{{ tick.y + 4 }}" text-anchor="end">{{ tick.label }}&nbsp;€</text>
        {% endfor %}
        <polygon points="{{ chart.series.income.area }}" fill="url(#area-income)"/>
        <polyline points="{{ chart.series.expense.line }}" fill="none" stroke="#7dbcff" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
        <polyline points="{{ chart.series.income.line }}" fill="none" stroke="#1f6fef" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
        {% for p in chart.series.expense.points %}<circle cx="{{ p.x }}" cy="{{ p.y }}" r="4" fill="#7dbcff" class="ring" stroke-width="1.5"/>{% endfor %}
        {% for p in chart.series.income.points %}<circle cx="{{ p.x }}" cy="{{ p.y }}" r="4" fill="#1f6fef" class="ring" stroke-width="1.5"/>{% endfor %}
        {% for l in chart.labels %}
            <text x="{{ l.x }}" y="{{ chart.bottom + 22 }}" text-anchor="middle">{{ l.month|short_date|split(' ')|last|capitalize }}</text>
        {% endfor %}
    </svg>
</div>
