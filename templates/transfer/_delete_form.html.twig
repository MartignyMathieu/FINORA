<form method="post" action="{{ path('app_transfer_delete', {'id': transfer.id}) }}" onsubmit="return confirm('Supprimer définitivement ce virement ? Les soldes des deux comptes seront rétablis.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ transfer.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
