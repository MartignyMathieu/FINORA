<form method="post" action="{{ path('app_recurring_delete', {id: recurring.id}) }}" onsubmit="return confirm('Supprimer cette récurrence ? Les transactions déjà générées sont conservées.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recurring.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
