{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <header class="page-head">
        <div class="only-desktop">
            <h1>Bonjour {{ displayName }},</h1>
            <p class="muted">Voici un aperçu de vos finances.</p>
        </div>
        <div class="greeting only-mobile">
            {{ include('_avatar.html.twig', {user: app.user, size: 24}) }}
            <span class="grow">Bonjour <strong>{{ displayName }}</strong>,</span>
        </div>
        {{ include('_month_nav.html.twig') }}
    </header>

    {{ include('_budget_alerts.html.twig') }}

    {# Mobile : carte de solde, accès rapides et aperçu #}
    <section class="balance-card only-mobile" aria-label="Solde total" data-controller="tilt">
        <div class="balance-top"><span>Solde total</span>{{ include('_eye_toggle.html.twig') }}</div>
        <div class="balance-amount"><span class="amt-real" data-controller="countup" data-countup-value-value="{{ balance|number_format(2, '.', '') }}" data-countup-currency-value="{{ currency }}">{{ balance|money(currency) }}</span>{{ include('_amount_mask.html.twig') }}</div>
        {% if variation is not null %}
            <span class="chip {{ variation < 0 ? 'negative' }}">{{ icon('trend', 16) }}{{ variation|number_format(1, ',', ' ') }}&nbsp;% ce mois-ci</span>
        {% endif %}
    </section>

    <nav class="quick-actions only-mobile" aria-label="Accès rapides">
        <a href="{{ path('app_transaction_new') }}"><span class="tile">{{ icon('plus', 22) }}</span>Ajouter</a>
        <a href="{{ path('app_transaction_index') }}"><span class="tile">{{ icon('card', 22) }}</span>Transactions</a>
        <a href="{{ path('app_goal_index') }}"><span class="tile">{{ icon('target', 22) }}</span>Objectifs</a>
        <a href="{{ path('app_settings') }}"><span class="tile">{{ icon('gear', 22) }}</span>Plus</a>
    </nav>

    <section class="card overview only-mobile" aria-label="Aperçu du mois">
        <h2>Mon aperçu <small>({{ month|month_label }})</small></h2>
        <div class="overview-row"><span class="tile tile-green">{{ icon('arrow-up', 22) }}</span><span class="grow">Revenus</span><strong>{{ totals.income|money(currency) }}</strong></div>
        <div class="overview-row"><span class="tile tile-red">{{ icon('arrow-down', 22) }}</span><span class="grow">Dépenses</span><strong>{{ (-totals.expense)|money(currency) }}</strong></div>
        <div class="overview-row"><span class="tile">{{ icon('piggy', 22) }}</span><span class="grow">Épargne</span><strong>{{ totals.savings|money(currency) }}</strong></div>
    </section>

    {# Bureau : indicateurs et graphiques #}
    <section class="kpis only-desktop" aria-label="Indicateurs du mois">
        {# Chaque carte s'incline en 3D vers le pointeur (tilt) ; les montants montent de 0 à leur valeur (countup). #}
        <div class="card kpi" data-controller="tilt"><span class="tile">{{ icon('wallet', 24) }}</span><div class="grow"><small>Solde total</small><strong><span class="amt-real" data-controller="countup" data-countup-value-value="{{ balance|number_format(2, '.', '') }}" data-countup-currency-value="{{ currency }}">{{ balance|money(currency) }}</span>{{ include('_amount_mask.html.twig') }}</strong></div>{{ include('_eye_toggle.html.twig', {class: 'eye-toggle-light'}) }}</div>
        <div class="card kpi" data-controller="tilt"><span class="tile tile-green">{{ icon('arrow-up', 24) }}</span><div><small>Revenus</small><strong data-controller="countup" data-countup-value-value="{{ totals.income|number_format(2, '.', '') }}" data-countup-currency-value="{{ currency }}">{{ totals.income|money(currency) }}</strong></div></div>
        <div class="card kpi" data-controller="tilt"><span class="tile tile-red">{{ icon('arrow-down', 24) }}</span><div><small>Dépenses</small><strong data-controller="countup" data-countup-value-value="{{ totals.expense|number_format(2, '.', '') }}" data-countup-currency-value="{{ currency }}">{{ totals.expense|money(currency) }}</strong></div></div>
        <div class="card kpi" data-controller="tilt"><span class="tile">{{ icon('piggy', 24) }}</span><div><small>Épargne</small><strong data-controller="countup" data-countup-value-value="{{ totals.savings|number_format(2, '.', '') }}" data-countup-currency-value="{{ currency }}">{{ totals.savings|money(currency) }}</strong></div></div>
    </section>

    {% if forecast %}
        {{ include('_forecast.html.twig') }}
    {% endif %}

    <section class="grid-2 only-desktop">
        <div class="card">
            <h2>Évolution de vos finances</h2>
            <div class="legend">
                <span><span class="dot" style="background:#1f6fef"></span>Revenus</span>
                <span><span class="dot" style="background:#7dbcff"></span>Dépenses</span>
            </div>
            {{ include('_line_chart.html.twig') }}
        </div>
        <div class="card card-donut">
            <h2>Répartition des dépenses</h2>
            {% if donut.items is empty %}
                <p class="empty">Aucune dépense en {{ month|month_label }}.</p>
            {% else %}
                <div class="donut-wrap" data-controller="donut">
                    {{ include('_donut.html.twig', {donut: donut, currency: currency, label: 'Dépenses'}) }}
                    <ul class="donut-legend">
                        {% for item in donut.items %}
                            <li tabindex="0" data-donut-target="item" data-index="{{ loop.index0 }}" data-label="{{ item.name }}" data-amount="{{ item.total|money(currency) }}"
                                data-action="mouseenter->donut#enter mouseleave->donut#leave focus->donut#enter blur->donut#leave"><span><span class="dot" style="background:{{ item.color }}"></span>{{ item.name }}</span><span class="pct">{{ item.percent }}&nbsp;%</span></li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </section>

    <section class="grid-2 only-desktop home-lists">
        <div class="card">
            <div class="card-head"><h2>Dernières transactions</h2><a href="{{ path('app_transaction_index') }}">Tout voir</a></div>
            {% if recent is empty %}
                <p class="empty">Aucune transaction en {{ month|month_label }}.</p>
            {% else %}
                <ul class="mini-list">
                    {% for transaction in recent %}
                        {% set income = transaction.type.value == 'income' %}
                        <li>
                            <a href="{{ path('app_transaction_show', {id: transaction.id}) }}">
                                <span class="tile {{ income ? 'tile-green' }}">{{ icon(transaction.category.icon ?? (income ? 'arrow-up' : 'tag'), 20) }}</span>
                                <span class="grow"><span class="name">{{ transaction.label }}</span><span class="sub">{{ transaction.category }} &bull; {{ transaction.date|short_date }}</span></span>
                                <span class="{{ income ? 'amount-in' : 'amount-out' }}">{{ (income ? transaction.amount : '-' ~ transaction.amount)|money(transaction.account.currency, true) }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
        <div class="card">
            <div class="card-head"><h2>Budgets du mois</h2><a href="{{ path('app_budget_index', {month: month|date('Y-m')}) }}">Tout voir</a></div>
            {% if budgets is empty %}
                <p class="empty">Aucun budget pour {{ month|month_label }}. <a href="{{ path('app_budget_new') }}">Créer un budget</a></p>
            {% else %}
                <ul class="mini-list">
                    {% for row in budgets %}
                        <li>
                            <a href="{{ path('app_budget_show', {id: row.budget.id}) }}" class="mini-budget">
                                <span class="tile">{{ icon(row.budget.category.icon ?? 'tag', 20) }}</span>
                                <span class="grow"><span class="name">{{ row.budget.category }}</span><span class="sub">{{ row.spent|money(row.budget.currency) }} / {{ row.budget.amount|money(row.budget.currency) }}</span></span>
                                <span class="pct {{ row.level == 'over' ? 'over' }}">{{ row.percent }}&nbsp;%</span>
                                <span class="bar {{ row.level }}" role="progressbar" aria-label="Budget {{ row.budget.category }}" aria-valuenow="{{ min(row.percent, 100) }}" aria-valuemin="0" aria-valuemax="100"><span style="width:{{ min(row.percent, 100) }}%"></span></span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>
{% endblock %}
