{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <header class="page-head">
        <h1>Catégories</h1>
        <a class="btn btn-primary" href="{{ path('app_category_new') }}">{{ icon('plus', 18) }}Nouvelle catégorie</a>
    </header>

    <div class="card">
        <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Nom</th><th>Icône</th><th>Couleur</th><th></th></tr>
            </thead>
            <tbody>
            {% for category in categories %}
                <tr>
                    <td><strong>{{ category.name }}</strong></td>
                    <td><span class="inline-icon">{{ icon(category.icon ?? 'tag', 20) }}{{ category.icon ? category.icon.label : '—' }}</span></td>
                    <td>{% if category.color %}<span class="swatch" style="background:{{ category.color }}"></span>{{ category.color }}{% else %}—{% endif %}</td>
                    <td><a href="{{ path('app_category_show', {id: category.id}) }}">Voir</a> · <a href="{{ path('app_category_edit', {id: category.id}) }}">Modifier</a></td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="empty">Aucune catégorie pour le moment.</td></tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
{% endblock %}
