{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block auth_body %}
    <form method="post" class="auth-form">
        {% if error %}
            <div class="flash flash-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <div>
            <label for="username">Adresse e-mail</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" autofocus required>
        </div>
        <div>
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>
            <a class="auth-forgot" href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
        </div>

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-primary btn-block" type="submit">Se connecter</button>
    </form>

    <a class="btn btn-block btn-soft" href="{{ path('app_register') }}">Créer un compte</a>
{% endblock %}
