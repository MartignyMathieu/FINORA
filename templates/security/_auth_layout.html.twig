{% extends 'base.html.twig' %}

{# Gabarit des pages publiques (connexion, inscription) : pas de navigation. #}
{% block layout %}
    <main class="auth">
        <div class="auth-card">
            <div class="auth-brand">
                {{ include('_coin.html.twig') }}
                <div class="auth-word">FINORA</div>
                <p class="auth-tagline">Maîtrisez votre argent.</p>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}" role="alert" data-controller="flash">{{ message }}<button type="button" class="flash-close" data-action="flash#close" aria-label="Fermer le message">&times;</button></div>
                {% endfor %}
            {% endfor %}

            {% block auth_body %}{% endblock %}
        </div>
    </main>
{% endblock %}
