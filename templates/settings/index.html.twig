{% extends 'base.html.twig' %}

{% block title %}Paramètres{% endblock %}

{% block body %}
    <header class="page-head">
        <div>
            <h1>Paramètres</h1>
            <p class="muted">Devise des totaux : {{ currency }}</p>
        </div>
    </header>

    <ul class="list settings">
        <li>
            <a class="list-card" href="{{ path('app_profile') }}">
                <span class="avatar" aria-hidden="true">{{ app.user.displayName|first|upper }}</span>
                <span class="grow"><span class="name">{{ app.user.displayName }}</span><span class="muted">{{ app.user.userIdentifier }}</span></span>
                <span class="chev">{{ icon('chevron-right') }}</span>
            </a>
        </li>
        <li>
            <section class="card appearance" aria-labelledby="appearance-title">
                <h2 id="appearance-title"><span class="tile">{{ icon('moon', 24) }}</span>Apparence</h2>
                <p class="muted">Clair, sombre, ou selon le réglage de votre appareil. Ce choix est enregistré dans ce navigateur.</p>
                <div class="segmented theme-switch" data-controller="theme" role="group" aria-label="Thème de l'application">
                    <button type="button" data-action="theme#set" data-theme-theme-param="auto" aria-pressed="true">{{ icon('auto', 18) }}Auto</button>
                    <button type="button" data-action="theme#set" data-theme-theme-param="light" aria-pressed="false">{{ icon('sun', 18) }}Clair</button>
                    <button type="button" data-action="theme#set" data-theme-theme-param="dark" aria-pressed="false">{{ icon('moon', 18) }}Sombre</button>
                </div>

                <h3 class="appearance-sub">Animations</h3>
                <p class="muted">« Auto » suit le réglage « réduire les animations » de votre appareil.</p>
                <div class="segmented motion-switch" data-controller="motion" role="group" aria-label="Animations de l'application">
                    <button type="button" data-action="motion#set" data-motion-choice-param="auto" aria-pressed="true">{{ icon('auto', 18) }}Auto</button>
                    <button type="button" data-action="motion#set" data-motion-choice-param="full" aria-pressed="false">{{ icon('play', 18) }}Complètes</button>
                    <button type="button" data-action="motion#set" data-motion-choice-param="reduce" aria-pressed="false">{{ icon('pause', 18) }}Réduites</button>
                </div>
            </section>
        </li>
        <li>
            <a class="list-card" href="{{ path('app_category_index') }}">
                <span class="tile">{{ icon('tag', 24) }}</span>
                <span class="grow"><span class="name">Catégories</span><span class="muted">Nom, icône et couleur de chaque catégorie</span></span>
                <span class="chev">{{ icon('chevron-right') }}</span>
            </a>
        </li>
        <li>
            <a class="list-card" href="{{ path('app_transaction_index') }}">
                <span class="tile">{{ icon('card', 24) }}</span>
                <span class="grow"><span class="name">Transactions</span><span class="muted">Toutes vos opérations</span></span>
                <span class="chev">{{ icon('chevron-right') }}</span>
            </a>
        </li>
        <li>
            <a class="list-card" href="{{ path('app_calendar') }}">
                <span class="tile">{{ icon('calendar', 24) }}</span>
                <span class="grow"><span class="name">Calendrier</span><span class="muted">Vos opérations jour par jour</span></span>
                <span class="chev">{{ icon('chevron-right') }}</span>
            </a>
        </li>
        <li>
            <a class="list-card" href="{{ path('app_recurring_index') }}">
                <span class="tile">{{ icon('repeat', 24) }}</span>
                <span class="grow"><span class="name">Récurrences</span><span class="muted">Revenus et dépenses automatiques</span></span>
                <span class="chev">{{ icon('chevron-right') }}</span>
            </a>
        </li>
        <li>
            <a class="list-card" href="{{ path('app_goal_index') }}">
                <span class="tile">{{ icon('target', 24) }}</span>
                <span class="grow"><span class="name">Objectifs d'épargne</span><span class="muted">Suivez l'avancement de vos projets</span></span>
                <span class="chev">{{ icon('chevron-right') }}</span>
            </a>
        </li>
        <li>
            <a class="list-card" href="{{ path('app_logout') }}">
                <span class="tile tile-red">{{ icon('logout', 24) }}</span>
                <span class="grow"><span class="name">Se déconnecter</span></span>
            </a>
        </li>
    </ul>
{% endblock %}
