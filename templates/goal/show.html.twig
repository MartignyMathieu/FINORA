{% extends 'base.html.twig' %}

{% block title %}Objectif{% endblock %}

{% block body %}
    <header class="page-head">
        <h1>{{ goal.name }}</h1>
        <a class="btn btn-ghost" href="{{ path('app_goal_index') }}">{{ icon('chevron-left', 16) }}Retour</a>
    </header>

    <div class="card form-card">
        <table class="table">
            <tbody>
                <tr><th>Nom</th><td>{{ goal.name }}</td></tr>
                <tr><th>Montant à atteindre</th><td>{{ goal.targetAmount|money(goal.currency) }}</td></tr>
                <tr><th>Déjà épargné</th><td>{{ goal.savedAmount|money(goal.currency) }}</td></tr>
                <tr><th>Avancement</th><td>{{ goal.progress }}&nbsp;%</td></tr>
                <tr><th>Échéance</th><td>{{ goal.targetDate ? goal.targetDate|month_label : '—' }}</td></tr>
            </tbody>
        </table>

        <div class="actions">
            <a class="btn btn-primary" href="{{ path('app_goal_edit', {'id': goal.id}) }}">Modifier</a>
            {{ include('goal/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
