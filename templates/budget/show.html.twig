{% extends 'base.html.twig' %}

{% block title %}Budget{% endblock %}

{% block body %}
    <header class="page-head">
        <h1>{{ budget.category }} · {{ budget.month|month_label }}</h1>
        <a class="btn btn-ghost" href="{{ path('app_budget_index') }}">{{ icon('chevron-left', 16) }}Retour</a>
    </header>

    <div class="card form-card">
        <table class="table">
            <tbody>
                <tr><th>Catégorie</th><td>{{ budget.category }}</td></tr>
                <tr><th>Mois</th><td>{{ budget.month|month_label }}</td></tr>
                <tr><th>Plafond</th><td>{{ budget.amount|money(budget.currency) }}</td></tr>
                <tr><th>Devise</th><td>{{ budget.currency }}</td></tr>
            </tbody>
        </table>

        <div class="actions">
            <a class="btn btn-primary" href="{{ path('app_budget_edit', {'id': budget.id}) }}">Modifier</a>
            {{ include('budget/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
