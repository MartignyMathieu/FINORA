{% extends 'base.html.twig' %}

{% block title %}Budgets{% endblock %}

{% block body %}
    <header class="page-head">
        <div class="page-title">
            <h1>Budgets</h1>
        </div>
        <div class="toolbar">
            {{ include('_month_nav.html.twig') }}
            <a class="round-btn" href="{{ path('app_budget_new') }}" aria-label="Nouveau budget">{{ icon('plus', 22) }}</a>
        </div>
    </header>

    {% if month|date('Y-m') == 'now'|date('Y-m') %}
        {{ include('_budget_alerts.html.twig') }}
    {% endif %}

    <ul class="list">
        {% for row in rows %}
            {% set budget = row.budget %}
            <li>
                <a class="budget-card" href="{{ path('app_budget_show', {id: budget.id}) }}">
                    <span class="tile">{{ icon(budget.category.icon ?? 'tag', 26) }}</span>
                    <span>
                        <span class="name">{{ budget.category }}</span><br>
                        <span class="sub">{{ row.spent|money(budget.currency) }} / {{ budget.amount|money(budget.currency) }}</span>
                    </span>
                    <span class="pct {{ row.level == 'over' ? 'over' }}">{{ row.percent }}&nbsp;%</span>
                    <span class="bar {{ row.level }}" role="progressbar" aria-valuenow="{{ min(row.percent, 100) }}" aria-valuemin="0" aria-valuemax="100"><span style="width:{{ min(row.percent, 100) }}%"></span></span>
                </a>
            </li>
        {% else %}
            <li class="card empty">Aucun budget pour {{ month|month_label }}. <a href="{{ path('app_budget_new') }}">Créer un budget</a></li>
        {% endfor %}
    </ul>
{% endblock %}
