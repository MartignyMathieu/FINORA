{% extends 'base.html.twig' %}

{% block title %}Transactions{% endblock %}

{% block body %}
    <header class="page-head">
        <h1>Transactions</h1>
        <div class="toolbar">
            <form class="search" method="get" role="search">
                {% if type != 'all' %}<input type="hidden" name="type" value="{{ type }}">{% endif %}
                {{ icon('search', 18) }}
                <input type="search" name="q" value="{{ q }}" placeholder="Rechercher" aria-label="Rechercher une transaction">
            </form>
            {# L'export reprend le filtre en cours (onglet et recherche) ; il n'est pas limité aux lignes affichées. #}
            <a class="round-btn" href="{{ path('app_export_transactions', {type: type != 'all' ? type : null, q: q ?: null}) }}" data-turbo="false"
               title="Exporter en CSV" aria-label="Exporter {{ type != 'all' or q ? 'les transactions filtrées' : 'toutes les transactions' }} en CSV">{{ icon('download', 22) }}</a>
            <a class="round-btn" href="{{ path('app_transaction_new') }}" aria-label="Nouvelle transaction">{{ icon('plus', 22) }}</a>
        </div>
    </header>

    {% set base_query = q ? {q: q} : {} %}
    <nav class="segmented" aria-label="Type de transactions">
        <a href="{{ path('app_transaction_index', base_query) }}" class="{{ type == 'all' ? 'active' }}">Toutes</a>
        <a href="{{ path('app_transaction_index', base_query|merge({type: 'income'})) }}" class="{{ type == 'income' ? 'active' }}">Revenus</a>
        <a href="{{ path('app_transaction_index', base_query|merge({type: 'expense'})) }}" class="{{ type == 'expense' ? 'active' }}">Dépenses</a>
    </nav>

    {% set current = null %}
    {% for transaction in transactions %}
        {% set key = transaction.date|date('Y-m') %}
        {% if key != current %}
            {% if current is not null %}</ul>{% endif %}
            <h2 class="month-heading">{{ transaction.date|month_label }}</h2>
            <ul class="tx-list">
            {% set current = key %}
        {% endif %}
        {% set income = transaction.type.value == 'income' %}
        <li>
            <a class="tx" href="{{ path('app_transaction_show', {id: transaction.id}) }}">
                <span class="tile {{ income ? 'tile-green' }}">{{ icon(transaction.category.icon ?? (income ? 'arrow-up' : 'tag'), 24) }}</span>
                <span class="grow">
                    <span class="name">{{ transaction.label }}</span>
                    <span class="sub">{{ transaction.category }} &bull; {{ transaction.date|short_date }}{% if transaction.recurringTransaction %} &bull; <span class="recurring-tag">{{ icon('repeat', 14) }}{{ transaction.recurringTransaction.frequency.label|lower }}</span>{% endif %}</span>
                </span>
                <span class="{{ income ? 'amount-in' : 'amount-out' }}">{{ (income ? transaction.amount : '-' ~ transaction.amount)|money(transaction.account.currency, true) }}</span>
            </a>
        </li>
        {% if loop.last %}</ul>{% endif %}
    {% else %}
        <div class="card empty">
            {% if q or type != 'all' %}Aucune transaction ne correspond à ce filtre.{% else %}Aucune transaction pour le moment.{% endif %}
            <a href="{{ path('app_transaction_new') }}">Ajouter une transaction</a>
        </div>
    {% endfor %}
{% endblock %}
