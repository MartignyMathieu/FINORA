{% extends 'base.html.twig' %}

{% block title %}Transaction index{% endblock %}

{% block body %}
    <h1>Transaction index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Label</th>
                <th>Amount</th>
                <th>Type</th>
                <th>Date</th>
                <th>Account</th>
                <th>Category</th>
                <th>Recurrence</th>
                <th>RecurrenceEndDate</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for transaction in transactions %}
            <tr>
                <td>{{ transaction.id }}</td>
                <td>{{ transaction.label }}</td>
                <td>{{ transaction.amount }} {{ transaction.account.currency }}</td>
                <td>{{ transaction.type.value }}</td>
                <td>{{ transaction.date ? transaction.date|date('Y-m-d') : '' }}</td>
                <td>{{ transaction.account }}</td>
                <td>{{ transaction.category }}</td>
                <td>{{ transaction.recurrence ? transaction.recurrence.value : '' }}</td>
                <td>{{ transaction.recurrenceEndDate ? transaction.recurrenceEndDate|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_transaction_show', {'id': transaction.id}) }}">show</a>
                    <a href="{{ path('app_transaction_edit', {'id': transaction.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_transaction_new') }}">Create new</a>
{% endblock %}
