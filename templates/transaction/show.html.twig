{% extends 'base.html.twig' %}

{% block title %}Transaction{% endblock %}

{% block body %}
    <header class="page-head">
        <h1>{{ transaction.label }}</h1>
        <a class="btn btn-ghost" href="{{ path('app_transaction_index') }}">{{ icon('chevron-left', 16) }}Retour</a>
    </header>

    <div class="card form-card">
        <table class="table">
            <tbody>
                <tr><th>Libellé</th><td>{{ transaction.label }}</td></tr>
                <tr><th>Montant</th><td>{{ transaction.amount|money(transaction.account.currency) }}</td></tr>
                <tr><th>Type</th><td>{{ transaction.type.label }}</td></tr>
                <tr><th>Date</th><td>{{ transaction.date|date('d/m/Y') }}</td></tr>
                <tr><th>Compte</th><td>{{ transaction.account }}</td></tr>
                <tr><th>Catégorie</th><td>{{ transaction.category }}</td></tr>
                <tr><th>Note</th><td>{{ transaction.note ?: '—' }}</td></tr>
                <tr><th>Origine</th><td>{% if transaction.recurringTransaction %}Générée par la récurrence « <a href="{{ path('app_recurring_edit', {id: transaction.recurringTransaction.id}) }}">{{ transaction.recurringTransaction.label }}</a> » ({{ transaction.recurringTransaction.frequency.label|lower }}){% else %}Saisie manuelle{% endif %}</td></tr>
            </tbody>
        </table>

        <div class="actions">
            <a class="btn btn-primary" href="{{ path('app_transaction_edit', {'id': transaction.id}) }}">Modifier</a>
            {{ include('transaction/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
