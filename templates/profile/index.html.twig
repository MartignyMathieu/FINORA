{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}

{% block body %}
    <header class="page-head">
        <div class="profile-head">
            <span class="avatar avatar-lg" aria-hidden="true">{{ app.user.displayName|first|upper }}</span>
            <div>
                <h1>{{ app.user.displayName }}</h1>
                <p class="muted">{{ app.user.userIdentifier }}</p>
            </div>
        </div>
        <a class="btn btn-soft" href="{{ path('app_logout') }}">{{ icon('logout', 18) }}Se déconnecter</a>
    </header>

    <section class="card profile-counts" aria-label="Mes données">
        <h2>Mes données</h2>
        <ul class="counts">
            <li><a href="{{ path('app_account_index') }}"><strong>{{ counts.accounts }}</strong><span>{{ icon('wallet', 18) }}Comptes</span></a></li>
            <li><a href="{{ path('app_transaction_index') }}"><strong>{{ counts.transactions }}</strong><span>{{ icon('card', 18) }}Transactions</span></a></li>
            <li><a href="{{ path('app_recurring_index') }}"><strong>{{ counts.recurring }}</strong><span>{{ icon('repeat', 18) }}Récurrences</span></a></li>
            <li><a href="{{ path('app_budget_index') }}"><strong>{{ counts.budgets }}</strong><span>{{ icon('basket', 18) }}Budgets</span></a></li>
            <li><a href="{{ path('app_goal_index') }}"><strong>{{ counts.goals }}</strong><span>{{ icon('target', 18) }}Objectifs</span></a></li>
            <li><a href="{{ path('app_category_index') }}"><strong>{{ counts.categories }}</strong><span>{{ icon('tag', 18) }}Catégories</span></a></li>
        </ul>
    </section>

    <div class="profile-forms">
        <section class="card form-card" id="informations">
            <h2>Informations</h2>
            {{ form_start(profileForm) }}
                {{ form_widget(profileForm) }}
                <div class="actions"><button class="btn btn-primary" type="submit">Enregistrer</button></div>
            {{ form_end(profileForm) }}
        </section>

        <section class="card form-card" id="email">
            <h2>Adresse e-mail</h2>
            {{ form_start(emailForm) }}
                {{ form_widget(emailForm) }}
                <div class="actions"><button class="btn btn-primary" type="submit">Changer l'adresse e-mail</button></div>
            {{ form_end(emailForm) }}
        </section>

        <section class="card form-card" id="mot-de-passe">
            <h2>Mot de passe</h2>
            {{ form_start(passwordForm) }}
                {{ form_widget(passwordForm) }}
                <div class="actions"><button class="btn btn-primary" type="submit">Changer le mot de passe</button></div>
            {{ form_end(passwordForm) }}
        </section>

        <section class="card form-card danger-zone" id="suppression">
            <h2>Supprimer mon compte</h2>
            <p class="muted">Cette action est définitive : votre compte et toutes vos données (comptes, transactions, récurrences, budgets, objectifs et catégories) sont supprimés immédiatement.</p>
            {{ form_start(deleteForm, {action: path('app_profile_delete'), attr: {onsubmit: "return confirm('Supprimer définitivement votre compte et toutes vos données ?');"}}) }}
                {{ form_widget(deleteForm) }}
                <div class="actions"><button class="btn btn-danger" type="submit">Supprimer définitivement mon compte</button></div>
            {{ form_end(deleteForm) }}
        </section>
    </div>
{% endblock %}
