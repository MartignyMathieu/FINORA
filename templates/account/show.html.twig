{% extends 'base.html.twig' %}

{% block title %}Compte{% endblock %}

{% block body %}
    <header class="page-head">
        <h1>{{ account.name }}</h1>
        <a class="btn btn-ghost" href="{{ path('app_account_index') }}">{{ icon('chevron-left', 16) }}Retour</a>
    </header>

    <div class="card form-card">
        <table class="table">
            <tbody>
                <tr><th>Nom</th><td>{{ account.name }}</td></tr>
                <tr><th>Type</th><td><span class="inline-icon">{{ icon(account.type, 20) }}{{ account.type.label }}</span></td></tr>
                <tr><th>Devise</th><td>{{ account.currency }}</td></tr>
                <tr><th>Solde initial</th><td>{{ account.initialBalance|money(account.currency) }}</td></tr>
            </tbody>
        </table>

        <div class="actions">
            <a class="btn btn-primary" href="{{ path('app_account_edit', {'id': account.id}) }}">Modifier</a>
            {{ include('account/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
